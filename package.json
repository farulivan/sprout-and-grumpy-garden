{
  "name": "sprout-and-grumpy-garden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "tsc --noEmit && tsc --noEmit -p src/sim && oxlint && vitest run && prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^4.2.1"
  }
}
