# Response headers for the hosted game. Cloudflare reads this file; Vite copies it into dist/ as it is.
# https://developers.cloudflare.com/workers/static-assets/headers/

# A file in assets/ is named after its contents, so a name never means two things: keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
